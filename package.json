{
  "name": "rag-knowledge-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "node scripts/dev-test.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib scripts tests proxy.ts",
    "eval": "pnpm run eval:prepare && promptfoo eval --env-file .env.local --no-cache",
    "eval:prepare": "tsx scripts/prepare-promptfoo.ts",
    "eval:check": "python scripts/eval_runner.py --check-dataset",
    "eval:view": "promptfoo view",
    "eval:generate": "tsx scripts/generate-eval-set.ts",
    "eval:sync": "tsx scripts/sync-telemetry-to-eval.ts",
    "eval:py:smoke": "python scripts/eval_runner.py --smoke --stream",
    "eval:py:full": "pnpm run eval:release",
    "eval:release": "python scripts/eval_runner.py --full --stream --release",
    "test": "tsx --test tests/*.test.ts",
    "test:authz": "python scripts/authz_check.py",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.98",
    "@google/genai": "^2.30.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.142",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.21.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "promptfoo": "^0.124.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.6.0"
}
